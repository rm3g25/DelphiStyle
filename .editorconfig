# Companion to CSharpCodeStyle.md (version 4.8.2)
# Everything here is machine-enforced, which is why the guide does not discuss it.
# Place at the repository root.
#
# "Machine-enforced" holds only if the build is told to care. Style rules
# (csharp_style_*, dotnet_style_*) are IDE-only unless EnforceCodeStyleInBuild
# is on, and CA rules need an analysis level. Put this in Directory.Build.props
# next to this file so every project inherits it:
#
#   <Project>
#     <PropertyGroup>
#       <Nullable>enable</Nullable>
#       <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
#       <AnalysisLevel>latest-recommended</AnalysisLevel>
#     </PropertyGroup>
#     <ItemGroup>
#       <!-- VSTHRD* rules below come from this package; without it they are silently ignored -->
#       <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.*">
#         <PrivateAssets>all</PrivateAssets>
#       </PackageReference>
#     </ItemGroup>
#   </Project>

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets}]
indent_size = 2

[*.cs]

#### Formatting ####

csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_preserve_single_line_blocks = true

# One statement, one line - no code on the same line as a brace
csharp_preserve_single_line_statements = false

#### var - inference where the type is obvious, explicit where it is not ####

csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion

#### Modern syntax that is strictly better ####

csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent

# Every arm produces a value -> switch expression (guide, section 3)
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# A lambda in a delegate variable is a local function without a name (guide, section 2)
csharp_style_prefer_local_over_anonymous_function = true:suggestion
# Captures nothing -> say so, and let the compiler hold you to it
csharp_prefer_static_local_function = true:suggestion

#### Correctness - errors, not suggestions ####

# Rethrow preserving the stack trace (throw; not throw ex;)
dotnet_diagnostic.CA2200.severity = error

# Sync API called inside an async method where an async one exists
# (File.ReadAllText instead of ReadAllTextAsync) - see guide, section 8
dotnet_diagnostic.CA1849.severity = warning

# Do not block on Task.Result / Wait() / GetAwaiter().GetResult() - see guide, section 8
dotnet_diagnostic.VSTHRD002.severity = warning

# ConfigureAwait(false): off here because this is the application default.
# In a library project override to warning - see guide, section 8
dotnet_diagnostic.CA2007.severity = none

# Types owning disposable fields must be disposable - see guide, section 10
dotnet_diagnostic.CA1001.severity = error
dotnet_diagnostic.CA2213.severity = warning

# Async method names end in Async
dotnet_diagnostic.VSTHRD200.severity = suggestion

#### Naming - the guide does not restate these ####

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.interface_prefix.capitalization = pascal_case
dotnet_naming_style.interface_prefix.required_prefix = I

# Private fields: _camelCase
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning

# Interfaces: IName
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_prefixed.style = interface_prefix
dotnet_naming_rule.interfaces_prefixed.severity = warning

# Types and members: PascalCase
dotnet_naming_symbols.types_and_members.applicable_kinds = class,struct,enum,delegate,property,method,event,namespace,local_function
dotnet_naming_rule.types_pascal.symbols = types_and_members
dotnet_naming_rule.types_pascal.style = pascal_case
dotnet_naming_rule.types_pascal.severity = warning

# Parameters and locals: camelCase, no prefix
dotnet_naming_symbols.params_and_locals.applicable_kinds = parameter,local
dotnet_naming_rule.params_camel.symbols = params_and_locals
dotnet_naming_rule.params_camel.style = camel_case
dotnet_naming_rule.params_camel.severity = warning
